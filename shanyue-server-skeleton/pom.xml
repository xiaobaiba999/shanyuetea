<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!--
        【本文件知识点：Maven 聚合工程】
        1. packaging 为 pom 的工程叫"父工程/聚合工程"，它自己不写代码，只负责两件事：
           - 聚合：下面 <modules> 声明的子模块会被一起构建（在父工程目录执行 mvn package 即可全量打包）
           - 继承：子模块天然继承这里的 <properties> 与 <dependencyManagement>
        2. <parent> 指向 spring-boot-starter-parent：
           - 统一管理 Spring Boot 全家桶依赖的版本号（我们不用再写 version）
           - 继承了大量常用插件配置（如资源过滤、编译插件）
        3. <dependencyManagement> 只"声明版本"不"真正引入依赖"：
           子模块里写 <dependency> 时不写 <version>，版本统一由这里决定 —— 多模块工程版本一致性的关键。
        4. 版本统一口径（v2.1）：Spring Boot 4.0.9 + JDK 17，整条依赖线全部换成 Boot 4 生态，
           不再有 Boot 2.7 与 Boot 4 两套口径并存的问题。
    -->
    <parent>
        <artifactId>spring-boot-starter-parent</artifactId>
        <groupId>org.springframework.boot</groupId>
        <version>4.0.9</version>
    </parent>

    <groupId>com.shanyue</groupId>
    <artifactId>shanyue</artifactId>
    <packaging>pom</packaging>
    <version>1.0-SNAPSHOT</version>
    <modules>
        <module>shanyue-common</module>
        <module>shanyue-pojo</module>
        <module>shanyue-server</module>
    </modules>

    <properties>
        <!-- Java 17：Spring Boot 4 的最低基线（低于 17 直接编译失败，装 8/11 会导致 Maven 导入失败） -->
        <java.version>17</java.version>
        <maven.compiler.source>17</maven.compiler.source>
        <maven.compiler.target>17</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>

        <!-- 版本集中管理：改版本只改这里（均已对齐 Spring Boot 4 生态线） -->
        <!-- MyBatis 官方 starter 的 4.x 线 = 专为 Spring Boot 4 适配的版本 -->
        <mybatis.spring>4.0.1</mybatis.spring>
        <!-- PageHelper 分页插件 starter 的 4.x 线（配套 Boot 4） -->
        <pagehelper>4.1.1</pagehelper>
        <!-- fastjson（课程同款 1.x）：主要用于规格快照 specSelected 的 JSON 序列化/解析 -->
        <fastjson>1.2.83</fastjson>
        <!-- JJWT 0.12.x：Jakarta 时代的新 API（0.9.1 依赖 javax.xml.bind，在 Boot 4 上不可用） -->
        <jjwt>0.12.6</jjwt>
        <!-- springdoc 3.x 线 = Spring Boot 4 配套的接口文档 -->
        <springdoc>3.1.1</springdoc>
    </properties>

    <dependencyManagement>
        <dependencies>
            <!-- MyBatis 官方提供的 Spring Boot 4 整合包（含自动配置、@Mapper 扫描） -->
            <dependency>
                <groupId>org.mybatis.spring.boot</groupId>
                <artifactId>mybatis-spring-boot-starter</artifactId>
                <version>${mybatis.spring}</version>
            </dependency>

            <!-- PageHelper：物理分页插件，PageHelper.startPage(页码, 每页条数) 后紧跟的第一条查询自动拼 limit -->
            <dependency>
                <groupId>com.github.pagehelper</groupId>
                <artifactId>pagehelper-spring-boot-starter</artifactId>
                <version>${pagehelper}</version>
            </dependency>

            <!-- fastjson（课程同款 1.x）：主要用于规格快照 specSelected 的 JSON 序列化/解析 -->
            <dependency>
                <groupId>com.alibaba</groupId>
                <artifactId>fastjson</artifactId>
                <version>${fastjson}</version>
            </dependency>

            <!--
                JJWT：生成与解析 JWT 令牌（登录凭证）。
                0.12.x 拆成三件套：jjwt-api（编译）+ jjwt-impl / jjwt-jackson（运行期），
                API 全面翻新：Jwts.builder().claims(...).signWith(key, Jwts.SIG.HS256) 生成，
                Jwts.parser().verifyWith(key).build().parseSignedClaims(token) 解析。
                （旧 0.9.1 依赖 javax.xml.bind，Boot 4 / Jakarta 环境下不可用；
                  新版也不再需要 jaxb-api，密钥长度须 ≥ 32 字节。）
            -->
            <dependency>
                <groupId>io.jsonwebtoken</groupId>
                <artifactId>jjwt-api</artifactId>
                <version>${jjwt}</version>
            </dependency>
            <dependency>
                <groupId>io.jsonwebtoken</groupId>
                <artifactId>jjwt-impl</artifactId>
                <version>${jjwt}</version>
            </dependency>
            <dependency>
                <groupId>io.jsonwebtoken</groupId>
                <artifactId>jjwt-jackson</artifactId>
                <version>${jjwt}</version>
            </dependency>

            <!--
                接口文档（springdoc 3.x 适配 Spring Boot 4）：
                坐标从 1.x 的 springdoc-openapi-ui 换成 springdoc-openapi-starter-webmvc-ui；
                @Tag / @Operation / @Schema 注解包名不变，Controller 一行不改；
                仅 GroupedOpenApi 的 import 从 org.springdoc.core 换到 org.springdoc.core.models。
                启动后访问 http://localhost:8080/swagger-ui/index.html 查看在线接口文档。
            -->
            <dependency>
                <groupId>org.springdoc</groupId>
                <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
                <version>${springdoc}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>
</project>
