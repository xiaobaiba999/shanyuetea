<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd" >
<!-- 套餐-饮品关联 Mapper（表 setmeal_drink，v1.2 起 drink 口径）：已写好 3 条 + 管理端批量语句留白（TODO 教学练习） -->
<mapper namespace="com.shanyue.mapper.SetmealDrinkMapper">

    <!-- 根据饮品 id 集合查关联的套餐 id（删饮品前的校验；distinct 去重防同一套餐多饮品重复计数） -->
    <select id="getSetmealIdsByDrinkIds" resultType="java.lang.Long">
        select distinct setmeal_id from setmeal_drink where drink_id in
        <foreach collection="drinkIds" item="id" open="(" close=")" separator=",">
            #{id}
        </foreach>
    </select>

    <!-- 根据套餐 id 查关联的饮品记录（套餐编辑页回显） -->
    <select id="getBySetmealId" resultType="com.shanyue.entity.SetmealDrink">
        select * from setmeal_drink where setmeal_id = #{setmealId}
    </select>

    <!-- 根据套餐 id 删关联（套餐更新"先删后插"的删） -->
    <delete id="deleteBySetmealId">
        delete from setmeal_drink where setmeal_id = #{setmealId}
    </delete>

    <!-- TODO 管理端：批量新增套餐-饮品关联（参照课程套餐明细 Mapper 的 insertBatch 写法） -->
    <!--
    <insert id="insertBatch">
        insert into setmeal_drink (name, price, drink_id, setmeal_id, copies) values
        <foreach collection="setmealDrinks" item="sd" separator=",">
            (#{sd.name}, #{sd.price}, #{sd.drinkId}, #{sd.setmealId}, #{sd.copies})
        </foreach>
    </insert>
    -->

    <!-- TODO 管理端：批量删除套餐-饮品关联（接口已贴好 @Param("ids")） -->
