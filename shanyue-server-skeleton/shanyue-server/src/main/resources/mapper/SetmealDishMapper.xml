<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd" >
<!-- 套餐-饮品关联 Mapper：已写好 3 条 + 管理端批量语句留白（TODO 教学练习） -->
<mapper namespace="com.shanyue.mapper.SetmealDishMapper">

    <!-- 根据饮品 id 集合查关联的套餐 id（删饮品前的校验；distinct 去重防同一套餐多饮品重复计数） -->
    <select id="getSetmealIdsByDishIds" resultType="java.lang.Long">
        select distinct setmeal_id from setmeal_dish where dish_id in
        <foreach collection="dishIds" item="id" open="(" close=")" separator=",">
            #{id}
        </foreach>
    </select>

    <!-- 根据套餐 id 查关联的饮品记录（套餐编辑页回显） -->
    <select id="getBySetmealId" resultType="com.shanyue.entity.SetmealDish">
        select * from setmeal_dish where setmeal_id = #{setmealId}
    </select>

    <!-- 根据套餐 id 删关联（套餐更新"先删后插"的删） -->
    <delete id="deleteBySetmealId">
        delete from setmeal_dish where setmeal_id = #{setmealId}
    </delete>

    <!-- TODO 管理端：批量新增套餐-饮品关联（参照课程 SetmealDishMapper.xml 的 insertBatch） -->
