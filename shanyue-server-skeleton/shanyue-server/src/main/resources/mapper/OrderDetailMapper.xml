<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd" >
<!-- 订单明细 Mapper：全部 SQL 集中于此（批量插 <foreach> + 按订单 id 查明细） -->
<mapper namespace="com.shanyue.mapper.OrderDetailMapper">

    <!-- 批量插入订单明细：下单时购物车 N 行 → 一次 insert N 行明细 -->
    <insert id="insertBatch">
        insert into order_detail (name, image, order_id, drink_id, setmeal_id, drink_flavor, spec_selected, number, amount)
        values
        <foreach collection="orderDetailList" item="od" separator=",">
            (#{od.name}, #{od.image}, #{od.orderId}, #{od.drinkId}, #{od.setmealId}, #{od.drinkFlavor}, #{od.specSelected}, #{od.number}, #{od.amount})
        </foreach>
    </insert>

    <!-- 根据订单 id 查明细（订单详情页 / 历史订单展开） -->
    <select id="getByOrderId" resultType="com.shanyue.entity.OrderDetail">
        select * from order_detail where order_id = #{orderId}
    </select>
</mapper>
