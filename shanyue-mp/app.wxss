/* app.wxss —— 全局样式与品牌变量 */
/* 山月茶咖品牌色：墨绿主色 + 茶金点缀 + 暖陶价格色 */
page {
  --brand: #2F5233;          /* 墨绿（主色） */
  --brand-light: #EAF1EB;    /* 墨绿浅底 */
  --accent: #C89B5A;         /* 茶金 */
  --price: #C7542F;          /* 价格暖陶 */
  --text: #2B2B2B;
  --text-sub: #8A8A8A;
  --line: #EFEFEA;
  --bg: #F5F6F4;
  --danger: #D9534F;
  background: var(--bg);
  color: var(--text);
  font-size: 28rpx;
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Helvetica Neue", sans-serif;
}

/* 通用卡片 */
.card {
  background: #fff;
  border-radius: 20rpx;
  padding: 24rpx;
  box-sizing: border-box;
}

/* 主按钮 */
.btn-primary {
  background: var(--brand);
  color: #fff;
  border-radius: 44rpx;
  font-size: 30rpx;
  text-align: center;
  padding: 22rpx 0;
}
.btn-primary.disabled {
  background: #C7CFC8;
  color: #F2F4F2;
}
/* 描边按钮 */
.btn-ghost {
  border: 2rpx solid var(--brand);
  color: var(--brand);
  border-radius: 44rpx;
  font-size: 28rpx;
  text-align: center;
  padding: 16rpx 0;
}

/* 底部安全区适配（iPhone 底部小黑条） */
.safe-bottom {
  padding-bottom: calc(16rpx + env(safe-area-inset-bottom));
}

/* 空状态 */
.empty-tip {
  text-align: center;
  color: var(--text-sub);
  font-size: 26rpx;
  padding: 80rpx 0;
}

/* 通用价格样式 */
.price-text {
  color: var(--price);
  font-weight: 600;
}
