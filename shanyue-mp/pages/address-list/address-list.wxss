/* pages/address-list/address-list.wxss */
.page {
  padding: 24rpx;
  box-sizing: border-box;
}
.addr-card {
  margin-bottom: 24rpx;
  padding-bottom: 12rpx;
}
.addr-line1 {
  display: flex;
  align-items: baseline;
}
.addr-name {
  font-size: 32rpx;
  font-weight: 700;
}
.addr-phone {
  margin-left: 16rpx;
  color: var(--ink-3);
  font-size: 26rpx;
}
.default-badge {
  margin-left: 16rpx;
  font-size: 20rpx;
  color: #fff;
  background: var(--pine);
  border-radius: 8rpx;
  padding: 4rpx 12rpx;
}
.label-badge {
  margin-left: 12rpx;
  font-size: 20rpx;
  color: var(--gold);
  border: 2rpx solid var(--gold);
  border-radius: 8rpx;
  padding: 2rpx 12rpx;
}
.addr-line2 {
  margin-top: 12rpx;
  font-size: 26rpx;
  color: var(--ink-2);
  line-height: 38rpx;
}
.addr-actions {
  display: flex;
  justify-content: flex-end;
  border-top: 2rpx solid #F2F2EE;
  margin-top: 16rpx;
  padding-top: 10rpx;
}
.action {
  font-size: 24rpx;
  color: var(--ink-2);
  padding: 12rpx 0 12rpx 36rpx;
}
.action.danger {
  color: var(--danger);
}
.add-btn {
  margin-top: 40rpx;
  background: var(--pine);
  color: #fff;
  border-radius: 48rpx;
  text-align: center;
  font-size: 30rpx;
  padding: 24rpx 0;
}
.select-tip {
  margin-top: 24rpx;
  text-align: center;
  font-size: 24rpx;
  color: var(--gold);
}
.empty-sub {
  margin-top: 12rpx;
  font-size: 24rpx;
}
