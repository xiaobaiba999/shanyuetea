/* pages/home/home.wxss —— 首页样式（宣纸 / 墨绿 / 茶金 体系；横幅/宫格与点单页同源） */
.page {
  min-height: 100vh;
  padding-bottom: 32rpx;
  box-sizing: border-box;
  background: transparent; /* 透出 page 级宣纸斜纹底 */
}

/* ===================== 品牌头 ===================== */
.brand-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 28rpx 32rpx;
  background: linear-gradient(150deg, #3A6140, var(--pine) 55%, var(--pine-deep));
  border-bottom: 3rpx solid rgba(200, 155, 90, .35);
}
.bh-left {
  display: flex;
  align-items: center;
  min-width: 0;
}
.bh-logo {
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  border: 3rpx solid var(--gold);
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, .25);
  flex: none;
}
.bh-texts {
  margin-left: 22rpx;
}
.bh-name {
  color: #F6F3EC;
  font-size: 40rpx;
  font-weight: 700;
  letter-spacing: 6rpx;
  text-shadow: 0 2rpx 8rpx rgba(0, 0, 0, .3);
}
.bh-slogan {
  margin-top: 8rpx;
  color: var(--gold-soft, #E8D9BC);
  font-size: 22rpx;
  letter-spacing: 2rpx;
}
.bh-state {
  flex: none;
  font-size: 22rpx;
  padding: 8rpx 20rpx;
  border-radius: 24rpx;
  border: 1rpx solid rgba(255, 255, 255, .5);
  box-sizing: border-box;
}
.bh-state.open {
  color: #F6F3EC;
  background: rgba(232, 240, 233, .16);
}
.bh-state.closed {
  color: #FFD9CF;
  background: rgba(181, 67, 47, .35);
}

/* ===================== 轮播横幅（与点单页同源样式） ===================== */
.banner-swiper {
  height: 220rpx;
  margin: 24rpx 24rpx 0;
}
.banner-card {
  height: 220rpx;
  border-radius: 24rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 40rpx 0 36rpx;
  box-sizing: border-box;
  overflow: hidden;
}
.banner-card.theme-pine {
  background: linear-gradient(135deg, #3A6140, var(--pine) 55%, var(--pine-deep));
}
.banner-card.theme-gold {
  background: linear-gradient(135deg, #D9B276, var(--gold) 60%, #A97F41);
}
.banner-card.theme-terracotta {
  background: linear-gradient(135deg, #D96A45, var(--terracotta) 60%, #9E3E22);
}
.banner-texts {
  min-width: 0;
}
.banner-title {
  color: #FFFFFF;
  font-size: 40rpx;
  font-weight: 700;
  letter-spacing: 4rpx;
  font-family: 'Noto Serif SC', 'Source Han Serif SC', 'Songti SC', 'STSong', 'SimSun', serif;
  text-shadow: 0 2rpx 8rpx rgba(43, 38, 32, .22);
}
.banner-sub {
  color: rgba(255, 255, 255, .88);
  font-size: 24rpx;
  margin-top: 12rpx;
  letter-spacing: 2rpx;
}
.banner-seal {
  flex: none;
  width: 88rpx;
  height: 88rpx;
  border: 3rpx solid rgba(255, 255, 255, .85);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #FFFFFF;
  font-size: 34rpx;
  font-family: 'Songti SC', 'STSong', 'SimSun', serif;
  transform: rotate(-6deg);
  background: rgba(255, 255, 255, .1);
}
.banner-skeleton {
  height: 220rpx;
  margin: 24rpx 24rpx 0;
  border-radius: 24rpx;
}

/* ===================== 功能宫格 ===================== */
.grid {
  margin: 24rpx;
  display: flex;
  align-items: center;
  padding: 28rpx 12rpx 24rpx;
}
.grid-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  min-width: 0;
}
.grid-icon {
  width: 84rpx;
  height: 84rpx;
  border-radius: 50%;
  background: var(--pine-mist);
  border: 2rpx solid rgba(47, 82, 51, .18);
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--pine);
  font-size: 34rpx;
  font-weight: 700;
  font-family: 'Songti SC', 'STSong', 'SimSun', serif;
}
.grid-avatar {
  width: 84rpx;
  height: 84rpx;
  border-radius: 50%;
  border: 3rpx solid var(--gold);
  box-sizing: border-box;
  box-shadow: 0 4rpx 10rpx rgba(200, 155, 90, .28);
}
.grid-text {
  margin-top: 12rpx;
  font-size: 24rpx;
  color: var(--ink-2);
}

/* ===================== 热销推荐 ===================== */
.sec {
  margin: 0 24rpx;
}
.sec-head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  padding: 0 8rpx;
}
.sec-title {
  font-size: 34rpx;
  font-weight: 700;
  color: var(--ink);
  letter-spacing: 4rpx;
}
.sec-title::before {
  content: '';
  display: inline-block;
  width: 8rpx;
  height: 30rpx;
  border-radius: 4rpx;
  background: var(--gold);
  margin-right: 14rpx;
}
.sec-more {
  font-size: 24rpx;
  color: var(--ink-3);
}
.hot-skeleton {
  display: flex;
  gap: 20rpx;
  margin-top: 20rpx;
}
.hot-sk-card {
  flex: none;
  width: 200rpx;
  height: 300rpx;
  border-radius: 20rpx;
}
.hot-scroll {
  margin-top: 20rpx;
  width: 100%;
  white-space: nowrap;
}
.hot-row {
  display: inline-flex;
  padding-bottom: 8rpx;
}
.hot-card {
  display: inline-flex;
  flex-direction: column;
  width: 208rpx;
  margin-right: 20rpx;
  padding: 16rpx;
  white-space: normal;
  vertical-align: top;
}
.hot-thumb {
  position: relative;
  width: 176rpx;
  height: 176rpx;
  border-radius: 16rpx;
  background: linear-gradient(135deg, var(--pine-mist), #D7E3D7);
  border: 1rpx solid rgba(47, 82, 51, .08);
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
}
.hot-char {
  font-size: 64rpx;
  font-weight: 700;
  color: var(--pine);
  opacity: 0.55;
  font-family: 'Noto Serif SC', 'Source Han Serif SC', 'Songti SC', 'STSong', 'SimSun', serif;
}
.hot-img {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
}
.hot-rank {
  position: absolute;
  top: 10rpx;
  left: 10rpx;
  font-size: 18rpx;
  font-weight: 700;
  color: #FFFFFF;
  background: rgba(43, 38, 32, .55);
  padding: 4rpx 12rpx;
  border-radius: 16rpx;
  letter-spacing: 1rpx;
}
.hot-name {
  margin-top: 14rpx;
  font-size: 28rpx;
  font-weight: 600;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.hot-meta {
  margin-top: 6rpx;
}
.hot-sales {
  font-size: 20rpx;
  color: var(--ink-3);
}
.hot-price {
  margin-top: 10rpx;
  color: var(--terracotta);
}
.hot-price .yen {
  font-size: 22rpx;
}
.hot-price .num {
  font-size: 34rpx;
  font-weight: 700;
  font-family: 'Noto Serif SC', 'Source Han Serif SC', 'Songti SC', 'STSong', 'SimSun', serif;
}

/* ===================== 门店信息卡 ===================== */
.shop-card {
  margin: 24rpx;
}
.shop-row {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
}
.shop-name {
  font-size: 32rpx;
  font-weight: 700;
  color: var(--ink);
}
.shop-hours {
  font-size: 22rpx;
  color: var(--ink-3);
}
.shop-row.sub {
  margin-top: 18rpx;
}
.shop-row.sub .k {
  flex: none;
  font-size: 22rpx;
  color: var(--ink-3);
  margin-right: 20rpx;
}
.shop-row.sub .v {
  font-size: 24rpx;
  color: var(--ink-2);
  text-align: right;
}
.shop-row.sub .phone {
  color: var(--pine);
  text-decoration: underline;
}
.go-order-btn {
  margin-top: 26rpx;
}
