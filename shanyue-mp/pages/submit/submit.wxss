/* pages/submit/submit.wxss —— 确认订单样式 */
.page {
  padding: 24rpx;
  padding-bottom: 180rpx;
  box-sizing: border-box;
}

/* 模式切换 */
.mode-seg {
  display: flex;
  background: #E9EDE8;
  border-radius: 20rpx;
  padding: 8rpx;
  margin-bottom: 24rpx;
}
.seg-item {
  flex: 1;
  text-align: center;
  padding: 16rpx 0;
  border-radius: 16rpx;
  color: #7B847C;
}
.seg-item.on {
  background: #fff;
  color: #2F5233;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.06);
}
.seg-title {
  font-size: 30rpx;
  font-weight: 600;
}
.seg-sub {
  font-size: 20rpx;
  margin-top: 4rpx;
}

/* 门店卡 / 地址卡 */
.store-card {
  margin-bottom: 24rpx;
}
.store-name {
  font-size: 34rpx;
  font-weight: 700;
  margin-bottom: 12rpx;
}
.store-row {
  font-size: 24rpx;
  color: #6E776F;
  line-height: 40rpx;
}
.pickup-tag {
  margin-top: 16rpx;
  display: inline-block;
  font-size: 22rpx;
  color: #2F5233;
  background: #EAF1EB;
  border-radius: 10rpx;
  padding: 8rpx 16rpx;
}
.address-card {
  margin-bottom: 24rpx;
}
.addr-top {
  display: flex;
  align-items: baseline;
}
.addr-person {
  font-size: 32rpx;
  font-weight: 700;
}
.addr-phone {
  margin-left: 16rpx;
  color: #8A8A8A;
  font-size: 26rpx;
}
.addr-label {
  margin-left: auto;
  font-size: 20rpx;
  color: #C89B5A;
  border: 2rpx solid #C89B5A;
  border-radius: 8rpx;
  padding: 2rpx 12rpx;
}
.addr-detail {
  margin-top: 12rpx;
  font-size: 26rpx;
  color: #4A4A4A;
  line-height: 38rpx;
}
.addr-empty {
  font-size: 30rpx;
  color: #2F5233;
  text-align: center;
  padding: 20rpx 0;
  font-weight: 600;
}

/* 明细 */
.sec-title {
  font-size: 28rpx;
  font-weight: 700;
  margin-bottom: 16rpx;
}
.goods-row {
  display: flex;
  align-items: center;
  padding: 14rpx 0;
}
.g-info {
  flex: 1;
  min-width: 0;
}
.g-name {
  font-size: 28rpx;
}
.g-spec {
  font-size: 22rpx;
  color: #8A8A8A;
  margin-top: 4rpx;
}
.g-qty {
  width: 90rpx;
  text-align: center;
  color: #8A8A8A;
  font-size: 26rpx;
}
.g-subtotal {
  width: 130rpx;
  text-align: right;
  font-size: 28rpx;
  font-weight: 600;
}

/* 备注 */
.remark {
  width: 100%;
  height: 120rpx;
  font-size: 26rpx;
  background: #F7F8F6;
  border-radius: 14rpx;
  padding: 16rpx;
  box-sizing: border-box;
}

/* 金额 */
.amount-card {
  margin-top: 24rpx;
}
.amount-row {
  display: flex;
  justify-content: space-between;
  font-size: 26rpx;
  color: #5B655C;
  padding: 8rpx 0;
}
.amount-row.total {
  border-top: 2rpx solid #EFEFEA;
  margin-top: 12rpx;
  padding-top: 20rpx;
  color: #2B2B2B;
  font-weight: 600;
}
.price .yen {
  font-size: 22rpx;
  color: #C7542F;
}
.price .num {
  font-size: 38rpx;
  font-weight: 700;
  color: #C7542F;
}

/* 底部提交条 */
.submit-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  background: #fff;
  display: flex;
  align-items: center;
  padding: 16rpx 30rpx;
  box-shadow: 0 -6rpx 20rpx rgba(0, 0, 0, 0.06);
  z-index: 20;
}
.sum {
  flex: 1;
}
.sum-label {
  font-size: 26rpx;
  color: #5B655C;
}
.sum .yen {
  font-size: 24rpx;
  color: #C7542F;
}
.sum .num {
  font-size: 42rpx;
  font-weight: 700;
  color: #C7542F;
}
.submit-btn {
  width: 240rpx;
  height: 88rpx;
  border-radius: 44rpx;
  background: #2F5233;
  color: #fff;
  font-size: 32rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}
.submit-btn.disabled {
  background: #C7CFC8;
}
