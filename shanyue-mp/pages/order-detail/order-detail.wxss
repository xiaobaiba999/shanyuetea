/* pages/order-detail/order-detail.wxss —— 详情页样式 */
.page {
  padding: 24rpx;
  padding-bottom: 200rpx;
  box-sizing: border-box;
}
.page .card {
  margin-bottom: 24rpx;
}

/* 状态头卡 */
.hero {
  background: linear-gradient(160deg, var(--pine), #3E6A45);
  border-radius: 20rpx;
  color: #fff;
  padding: 36rpx 30rpx 30rpx;
  margin-bottom: 24rpx;
  text-align: center;
}
.hero.cancelled {
  background: linear-gradient(160deg, #8B9298, #6E757B);
}
/* 茶小月状态像：金描边圆像（掌炉慢煨 / 月圆茶满） */
.hero-mascot {
  width: 150rpx;
  height: 150rpx;
  border-radius: 50%;
  border: 4rpx solid var(--gold);
  background: #F6F3EC;
  margin: 0 auto 16rpx;
  display: block;
}
.hero-status {
  font-size: 40rpx;
  font-weight: 700;
  letter-spacing: 2rpx;
}
.hero-mode {
  margin-top: 8rpx;
  font-size: 24rpx;
  opacity: 0.85;
}
.hero-pickup-label {
  margin-top: 26rpx;
  font-size: 24rpx;
  opacity: 0.85;
  letter-spacing: 6rpx;
}
.hero-pickup {
  font-family: "Menlo", "Consolas", "Courier New", monospace;
  font-size: 120rpx;
  font-weight: 800;
  letter-spacing: 8rpx;
  line-height: 1.4;
  color: #F5E7C8;
}
.hero-pickup-tip {
  font-size: 22rpx;
  opacity: 0.8;
  letter-spacing: 4rpx;
}

/* 状态步骤条 */
.steps-card {
  padding: 34rpx 20rpx 30rpx;
}
.steps {
  display: flex;
  align-items: flex-start;
}
.step {
  display: flex;
  flex-direction: column;
  align-items: center;
  width: 96rpx;
  flex: none;
}
.dot {
  width: 36rpx;
  height: 36rpx;
  border-radius: 50%;
  background: var(--paper-deep);
  border: 4rpx solid var(--card-line);
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 20rpx;
  color: #fff;
  position: relative;
}
.step-label {
  margin-top: 12rpx;
  font-size: 20rpx;
  color: var(--ink-3);
  white-space: nowrap;
}
.step.done .dot {
  background: var(--pine);
  border-color: var(--pine);
}
/* 已完成步骤的白勾（CSS 绘制） */
.step.done .dot::after {
  content: '';
  position: absolute;
  left: 50%;
  top: 46%;
  width: 8rpx;
  height: 14rpx;
  border-right: 4rpx solid #fff;
  border-bottom: 4rpx solid #fff;
  transform: translate(-50%, -50%) rotate(45deg);
  border-radius: 1rpx;
}
.step.done .step-label {
  color: var(--pine);
}
.step.active .dot {
  background: var(--gold);
  border-color: var(--gold);
  box-shadow: 0 0 0 8rpx rgba(200, 155, 90, 0.18);
}
.step.active .step-label {
  color: #2B2B2B;
  font-weight: 700;
}
.bar {
  flex: 1;
  height: 6rpx;
  border-radius: 3rpx;
  background: #E7EAE4;
  margin-top: 15rpx;
}
.bar.done {
  background: var(--pine);
}

/* 通用标题 / 信息行 */
.sec-title {
  font-size: 28rpx;
  font-weight: 700;
  margin-bottom: 14rpx;
}
.info-row {
  display: flex;
  padding: 10rpx 0;
  font-size: 26rpx;
  align-items: baseline;
}
.info-row .k {
  width: 150rpx;
  color: var(--ink-3);
  flex: none;
}
.info-row .v {
  flex: 1;
  word-break: break-all;
}
.info-row .number {
  flex: none;
  max-width: 380rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.copy-btn {
  flex: none;
  margin-left: 16rpx;
  font-size: 22rpx;
  color: var(--pine);
  border: 2rpx solid var(--pine);
  border-radius: 8rpx;
  padding: 2rpx 14rpx;
}
.paid {
  color: var(--pine);
  font-weight: 600;
}
.unpaid-text {
  color: #E6A23C;
  font-weight: 600;
}

/* 品项明细 */
.goods-row {
  display: flex;
  align-items: center;
  padding: 14rpx 0;
  border-bottom: 2rpx dashed #F0F0EB;
}
.goods-row:last-child {
  border-bottom: none;
}
.g-info {
  flex: 1;
  min-width: 0;
}
.g-name {
  font-size: 28rpx;
}
.g-spec {
  font-size: 22rpx;
  color: var(--ink-3);
  margin-top: 4rpx;
}
.g-qty {
  width: 90rpx;
  text-align: center;
  color: var(--ink-3);
  font-size: 26rpx;
}
.g-subtotal {
  width: 130rpx;
  text-align: right;
  font-size: 28rpx;
  font-weight: 600;
}

/* 金额明细 */
.amount-row {
  display: flex;
  justify-content: space-between;
  font-size: 26rpx;
  color: var(--ink-2);
  padding: 8rpx 0;
}
.amount-row.total {
  border-top: 2rpx solid var(--card-line);
  margin-top: 12rpx;
  padding-top: 20rpx;
  color: #2B2B2B;
  font-weight: 600;
  align-items: center;
}
.price .yen {
  font-size: 22rpx;
  color: var(--terracotta);
}
.price .num {
  font-size: 38rpx;
  font-weight: 700;
  color: var(--terracotta);
}

/* 底部操作条 */
.action-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  background: #fff;
  display: flex;
  align-items: center;
  justify-content: flex-end;
  padding: 16rpx 30rpx;
  box-shadow: 0 -6rpx 20rpx rgba(0, 0, 0, 0.06);
  z-index: 20;
}
.act-btn {
  margin-left: 20rpx;
  border-radius: 44rpx;
  font-size: 28rpx;
  padding: 18rpx 52rpx;
  text-align: center;
}
.act-btn.primary {
  background: var(--pine);
  color: #fff;
}
.act-btn.pay {
  background: var(--terracotta);
  color: #fff;
  box-shadow: 0 8rpx 20rpx rgba(199, 84, 47, 0.28);
}
.act-btn.ghost {
  border: 2rpx solid #C9D2CA;
  color: var(--ink-2);
}
