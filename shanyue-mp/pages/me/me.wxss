/* pages/me/me.wxss —— 我的页样式 */
.page {
  min-height: 100vh;
  padding: 24rpx;
  box-sizing: border-box;
}
.page .card {
  margin-bottom: 24rpx;
}

/* 用户卡（墨绿渐变，与登录页品牌视觉呼应） */
.user-card {
  background: linear-gradient(160deg, #2F5233, #3E6A45);
  border-radius: 20rpx;
  padding: 40rpx 30rpx;
  display: flex;
  align-items: center;
  margin-bottom: 24rpx;
  box-shadow: 0 10rpx 24rpx rgba(47, 82, 51, 0.22);
}
.avatar {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  background: #F7F4EC;
  flex: none;
}
.avatar.default {
  display: flex;
  align-items: center;
  justify-content: center;
}
.avatar-char {
  font-size: 60rpx;
  font-weight: 700;
  color: #2F5233;
}
.user-info {
  margin-left: 26rpx;
  min-width: 0;
}
.nick {
  font-size: 36rpx;
  font-weight: 700;
  color: #fff;
}
.uid {
  margin-top: 10rpx;
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.72);
}

/* 积分卡 */
.points-card {
  display: flex;
  align-items: center;
}
.points-left {
  flex: none;
  text-align: center;
  padding-right: 30rpx;
}
.points-num {
  font-size: 56rpx;
  font-weight: 800;
  color: #C89B5A;
  line-height: 1.2;
}
.points-label {
  margin-top: 4rpx;
  font-size: 22rpx;
  color: #8A8A8A;
}
.points-tip {
  flex: 1;
  font-size: 24rpx;
  color: #8A8A8A;
  line-height: 36rpx;
  border-left: 2rpx solid #F2F2EE;
  padding-left: 30rpx;
}

/* 菜单列表 */
.menu-card {
  padding: 8rpx 24rpx;
}
.menu-item {
  display: flex;
  align-items: center;
  padding: 30rpx 0;
  border-bottom: 2rpx solid #F5F6F4;
}
.menu-item:last-child {
  border-bottom: none;
}
.mi-icon {
  font-size: 32rpx;
  margin-right: 20rpx;
}
.mi-text {
  flex: 1;
  font-size: 28rpx;
}
.mi-arrow {
  font-size: 32rpx;
  color: #C0C6BF;
}

/* 退出登录 */
.logout-btn {
  margin-top: 40rpx;
  border: 2rpx solid #D9534F;
  color: #D9534F;
  border-radius: 48rpx;
  text-align: center;
  font-size: 28rpx;
  padding: 20rpx 0;
}

/* 关于门店弹层（与菜单页弹层同风格） */
.popup-mask {
  position: fixed;
  inset: 0;
  background: rgba(0, 0, 0, 0.45);
  z-index: 50;
  display: flex;
  align-items: flex-end;
}
.about-sheet {
  width: 100%;
  background: #fff;
  border-radius: 32rpx 32rpx 0 0;
  padding: 30rpx 30rpx 24rpx;
  box-sizing: border-box;
  animation: rise 0.2s ease-out;
}
@keyframes rise {
  from { transform: translateY(40%); opacity: 0.6; }
  to { transform: translateY(0); opacity: 1; }
}
.about-head {
  display: flex;
  justify-content: space-between;
  align-items: center;
}
.about-name {
  font-size: 34rpx;
  font-weight: 700;
}
.about-close {
  font-size: 32rpx;
  color: #8A8A8A;
  padding: 8rpx;
}
.about-slogan {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #C89B5A;
  letter-spacing: 2rpx;
}
.about-row {
  display: flex;
  padding: 22rpx 0;
  font-size: 26rpx;
  border-bottom: 2rpx solid #F5F6F4;
  align-items: baseline;
}
.about-row:last-of-type {
  border-bottom: none;
}
.about-row .k {
  width: 160rpx;
  color: #8A8A8A;
  flex: none;
}
.about-row .v {
  flex: 1;
  line-height: 38rpx;
}
.about-row .phone {
  color: #2F5233;
  font-weight: 600;
}
.about-tip {
  margin-top: 8rpx;
  text-align: center;
  font-size: 22rpx;
  color: #A9AFA8;
}
