/* pages/me/me.wxss —— 我的页样式 */
.page {
  min-height: 100vh;
  padding: 24rpx;
  box-sizing: border-box;
}
.page .card {
  margin-bottom: 24rpx;
}

/* 用户卡（墨绿渐变，与登录页品牌视觉呼应） */
.user-card {
  background: linear-gradient(160deg, var(--pine), #3E6A45);
  border-radius: 20rpx;
  padding: 40rpx 30rpx;
  display: flex;
  align-items: center;
  margin-bottom: 24rpx;
  box-shadow: 0 10rpx 24rpx rgba(47, 82, 51, 0.22);
}
.avatar {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  background: #F7F4EC;
  flex: none;
}
.avatar.default {
  border: 4rpx solid var(--gold);
}
.user-info {
  margin-left: 26rpx;
  min-width: 0;
}
.nick {
  font-size: 36rpx;
  font-weight: 700;
  color: #fff;
}
.uid {
  margin-top: 10rpx;
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.72);
}

/* 积分卡 */
.points-card {
  display: flex;
  align-items: center;
}
.points-left {
  flex: none;
  text-align: center;
  padding-right: 30rpx;
}
.points-num {
  font-size: 56rpx;
  font-weight: 800;
  color: var(--gold);
  line-height: 1.2;
}
.points-label {
  margin-top: 4rpx;
  font-size: 22rpx;
  color: var(--ink-3);
}
.points-tip {
  flex: 1;
  font-size: 24rpx;
  color: var(--ink-3);
  line-height: 36rpx;
  border-left: 2rpx solid #F2F2EE;
  padding-left: 30rpx;
}

/* 菜单列表 */
.menu-card {
  padding: 8rpx 24rpx;
}
.menu-item {
  display: flex;
  align-items: center;
  padding: 30rpx 0;
  border-bottom: 2rpx solid var(--paper);
}
.menu-item:last-child {
  border-bottom: none;
}
/* 菜单行印章字：茶金描边圆 + 衡线单字 */
.mi-icon {
  width: 56rpx;
  height: 56rpx;
  margin-right: 20rpx;
  border: 2rpx solid var(--gold);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-family: 'Songti SC', 'STSong', 'SimSun', serif;
  font-size: 26rpx;
  color: var(--pine);
  transform: rotate(-4deg);
  flex: none;
}
.mi-text {
  flex: 1;
  font-size: 28rpx;
}
.mi-arrow {
  font-size: 32rpx;
  color: #C0C6BF;
}

/* 退出登录 */
.logout-btn {
  margin-top: 40rpx;
  border: 2rpx solid var(--danger);
  color: var(--danger);
  border-radius: 48rpx;
  text-align: center;
  font-size: 28rpx;
  padding: 20rpx 0;
}

/* 关于门店弹层（与菜单页弹层同风格） */
.popup-mask {
  position: fixed;
  inset: 0;
  background: rgba(0, 0, 0, 0.45);
  z-index: 50;
  display: flex;
  align-items: flex-end;
}
.about-sheet {
  width: 100%;
  background: #fff;
  border-radius: 32rpx 32rpx 0 0;
  padding: 30rpx 30rpx 24rpx;
  box-sizing: border-box;
  animation: rise 0.2s ease-out;
}
@keyframes rise {
  from { transform: translateY(40%); opacity: 0.6; }
  to { transform: translateY(0); opacity: 1; }
}
.about-head {
  display: flex;
  justify-content: space-between;
  align-items: center;
}
.about-name {
  font-size: 34rpx;
  font-weight: 700;
}
.about-close {
  font-size: 32rpx;
  color: var(--ink-3);
  padding: 8rpx;
}
.about-slogan {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: var(--gold);
  letter-spacing: 2rpx;
}
.about-row {
  display: flex;
  padding: 22rpx 0;
  font-size: 26rpx;
  border-bottom: 2rpx solid var(--paper);
  align-items: baseline;
}
.about-row:last-of-type {
  border-bottom: none;
}
.about-row .k {
  width: 160rpx;
  color: var(--ink-3);
  flex: none;
}
.about-row .v {
  flex: 1;
  line-height: 38rpx;
}
.about-row .phone {
  color: var(--pine);
  font-weight: 600;
}
.about-tip {
  margin-top: 8rpx;
  text-align: center;
  font-size: 22rpx;
  color: #A9AFA8;
}

/* ===================== 【v2/F2】会员等级卡 ===================== */
.member-card {
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: linear-gradient(135deg, #3A6140, var(--pine) 55%, var(--pine-deep));
  border-radius: 24rpx;
  padding: 28rpx 32rpx;
  box-shadow: inset 0 2rpx 0 rgba(255, 255, 255, .1), 0 8rpx 24rpx rgba(47, 82, 51, .25);
  box-sizing: border-box;
}
.member-left { flex: 1; min-width: 0; }
.member-lv {
  color: #FFFFFF;
  font-size: 34rpx;
  font-weight: 700;
  letter-spacing: 2rpx;
  font-family: 'Noto Serif SC', 'Source Han Serif SC', 'Songti SC', 'STSong', 'SimSun', serif;
}
.member-title {
  margin-left: 16rpx;
  font-size: 22rpx;
  font-weight: 400;
  color: rgba(255, 255, 255, .78);
  letter-spacing: 4rpx;
}
.member-next {
  margin-top: 10rpx;
  font-size: 22rpx;
  color: rgba(255, 255, 255, .82);
}
.member-bar {
  margin-top: 18rpx;
  height: 10rpx;
  border-radius: 6rpx;
  background: rgba(255, 255, 255, .22);
  overflow: hidden;
}
.member-bar-fill {
  height: 100%;
  border-radius: 6rpx;
  background: linear-gradient(90deg, var(--gold), #E4C288);
}
.member-arrow {
  flex: none;
  margin-left: 20rpx;
  color: rgba(255, 255, 255, .7);
  font-size: 40rpx;
}
