<!-- pages/address-edit/address-edit.wxml —— 新增/编辑地址表单（省市区 picker + chip 选择 + 默认 switch） -->
<view class="page safe-bottom">
  <view class="card form-card">
    <!-- 联系人 -->
    <view class="field">
      <view class="f-label">联系人</view>
      <input
        class="f-input"
        value="{{form.consignee}}"
        placeholder="收货人姓名"
        placeholder-class="ph"
        bindinput="onInputField"
        data-field="consignee"
      />
    </view>

    <!-- 手机号 -->
    <view class="field">
      <view class="f-label">手机号</view>
      <input
        class="f-input"
        type="number"
        maxlength="11"
        value="{{form.phone}}"
        placeholder="11 位手机号"
        placeholder-class="ph"
        bindinput="onInputField"
        data-field="phone"
      />
    </view>

    <!-- 性别 chip -->
    <view class="field col">
      <view class="f-label">性别</view>
      <view class="chips">
        <view
          wx:for="{{sexes}}"
          wx:key="value"
          class="chip {{form.sex === item.value ? 'on' : ''}}"
          bindtap="onPickSex"
          data-value="{{item.value}}"
        >{{item.text}}</view>
      </view>
    </view>

    <!-- 所在地区：微信原生省市区三级联动（picker mode="region"）
         点整行弹系统省市区选择器，选中后回填 form 六字段（编号+名称成对） -->
    <picker mode="region" value="{{regionValue}}" bindchange="onRegionChange">
      <view class="field region-row">
        <view class="f-label">所在地区</view>
        <view class="region-text {{form.provinceName ? '' : 'ph'}}">
          {{form.provinceName ? form.provinceName + ' ' + form.cityName + ' ' + form.districtName : '请选择省 / 市 / 区'}}
        </view>
        <view class="region-arrow">›</view>
      </view>
    </picker>

    <!-- 详细地址 -->
    <view class="field col">
      <view class="f-label">详细地址</view>
      <textarea
        class="f-textarea"
        value="{{form.detail}}"
        placeholder="街道、楼栋、门牌号、楼层等"
        placeholder-class="ph"
        maxlength="60"
        bindinput="onInputField"
        data-field="detail"
      />
    </view>

    <!-- 标签 chip：家 / 公司 / 学校 -->
    <view class="field col">
      <view class="f-label">标签</view>
      <view class="chips">
        <view
          wx:for="{{labels}}"
          wx:key="*this"
          class="chip {{form.label === item ? 'on' : ''}}"
          bindtap="onPickLabel"
          data-value="{{item}}"
        >{{item}}</view>
      </view>
    </view>

    <!-- 设为默认 -->
    <view class="field row">
      <view class="field-left">
        <view class="f-label">设为默认地址</view>
        <view class="f-sub">外送下单时默认使用该地址</view>
      </view>
      <switch checked="{{form.isDefault === 1}}" color="#2F5233" bindchange="onDefaultChange" />
    </view>
  </view>

  <!-- 保存 -->
  <view class="save-btn {{saving ? 'disabled' : ''}}" bindtap="onSave">保存</view>

  <!-- 删除（仅编辑态提供） -->
  <view wx:if="{{isEdit}}" class="delete-btn" bindtap="onDelete">删除该地址</view>
</view>
