/* pages/checkin/checkin.wxss —— F5 每日签到（简化版）：统计条 + 签到按钮 + 规则卡 */
.page {
  padding: 24rpx;
  padding-bottom: calc(env(safe-area-inset-bottom) + 24rpx);
  box-sizing: border-box;
}

/* —— 统计条（三格卡片 + 竖分隔线） —— */
.stat-bar {
  display: flex;
  align-items: center;
  margin-bottom: 24rpx;
}
.stat {
  flex: 1;
  text-align: center;
}
.stat-num {
  font-size: 56rpx;
  font-weight: 700;
  color: var(--pine);
  line-height: 1.2;
  font-variant-numeric: tabular-nums;
}
.stat-num.points {
  color: var(--gold);
}
.stat-label {
  margin-top: 4rpx;
  font-size: 22rpx;
  color: var(--ink-3);
  letter-spacing: 2rpx;
}
.stat-divider {
  width: 2rpx;
  height: 64rpx;
  background: var(--card-line);
}

/* —— 签到大按钮 —— */
.sign-btn {
  margin: 0 8rpx 24rpx;
  letter-spacing: 2rpx;
}

/* —— 规则说明卡 —— */
.rule-card {
  margin-bottom: 24rpx;
}
.rule-title {
  font-size: 26rpx;
  font-weight: 700;
  color: var(--ink-2);
  letter-spacing: 2rpx;
  margin-bottom: 10rpx;
}
.rule-text {
  font-size: 22rpx;
  color: var(--ink-3);
  line-height: 1.9;
}
