<!-- pages/checkin/checkin.wxml —— 每日签到（简化版）：统计条 + 签到大按钮 + 规则说明（日历已按需求移除） -->
<view class="page safe-bottom">
  <view wx:if="{{loading}}" class="empty-tip">加载中…</view>

  <block wx:else>
    <!-- 统计条：连签 / 累计 / 积分（衬线大数字） -->
    <view class="card stat-bar">
      <view class="stat">
        <view class="stat-num font-serif">{{streak}}</view>
        <view class="stat-label">连续签到天数</view>
      </view>
      <view class="stat-divider"></view>
      <view class="stat">
        <view class="stat-num font-serif">{{totalDays}}</view>
        <view class="stat-label">累计签到天数</view>
      </view>
      <view class="stat-divider"></view>
      <view class="stat">
        <view class="stat-num font-serif points">{{points}}</view>
        <view class="stat-label">当前积分</view>
      </view>
    </view>

    <!-- 签到大按钮（todaySigned 时为禁用态文案） -->
    <view
      class="btn-primary sign-btn {{todaySigned ? 'disabled' : ''}}"
      hover-class="btn-hover"
      bindtap="onSign"
    >{{signBtnText}}</view>

    <!-- 规则说明卡 -->
    <view class="card rule-card">
      <view class="rule-title">签到规则</view>
      <view class="rule-text">每日签到 +5 山月积分；连签 7 天额外 +50 积分（演示口径）。</view>
      <view class="rule-text">签到状态后端用 Redis BITMAP 存储，实现思路见教学文档。</view>
    </view>
  </block>

  <!-- 茶小月 AI 悬浮球（滑动隐藏 · 静置 2 秒再现） -->
  <ai-ball id="ai-ball" />
</view>
