            "price": 1790,
            "number": 1,
            "amount": 2090
          },
          {
            "id": 3002,
            "drinkId": 1,
            "drinkName": "生椰拿铁",
            "image": "/menu/coconut-latte.png",
            "specText": "中杯/热/标准糖/标准浓度",
            "specKey": "1-11,32,41,67",
            "price": 1590,
            "number": 1,
            "amount": 1590
          }
        ]
      },
      {
        "id": 101,
        "orderNumber": "20250922002",
        "pickUpCode": "A02",
        "status": 2,
        "orderAmount": 2580,
        "remark": "打包",
        "phone": "13900005678",
        "cancelReason": null,
        "orderTime": "2025-09-22 12:26:00",
        "checkoutTime": "2025-09-22 12:26:00",
        "estimatedWaitMinutes": 8,
        "orderItems": [
          {
            "id": 2001,
            "drinkId": 1,
            "drinkName": "生椰拿铁",
            "image": "/menu/coconut-latte.png",
